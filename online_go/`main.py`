from fastapi import FastAPI, Depends
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel
from typing import Optional

app = FastAPI()

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_methods=["*"],
    allow_headers=["*"],
)

class User(BaseModel):
    username: str
    session_token: Optional[str] = None

@app.get("/")
async def root():
    return {"message": "Welcome to Online-go.com API"}

@app.post("/login")
async def login(user: User):
    # Mock login logic
    user.session_token = "mock_session_token"
    return {"username": user.username, "session_token": user.session_token}

@app.post("/logout")
async def logout(user: User):
    # Mock logout logic
    return {"message": f"User {user.username} logged out"}